PORT=5000
HOST=127.0.0.1
NODE_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=45000
CLIENT_ORIGIN=http://localhost:5173
# Public https URL of the client. Alert texts to contacts link to <PUBLIC_BASE_URL>/?track=<token>
PUBLIC_BASE_URL=http://localhost:5173

# Number of reverse proxies in front of the server (Render, Vercel, Nginx...). Default: 1 when NODE_ENV=production, none otherwise.
# Wrong values either put every visitor in one rate-limit bucket (too low) or let clients spoof their IP (too high).
TRUST_PROXY=

# Admin API (moderation queue, help points). Use a long random string. Admin routes are disabled while empty.
ADMIN_TOKEN=
# New public reports wait for admin approval. Set to "off" to publish them immediately.
MODERATION_MODE=pre

# Persistence (Node 22.13+). SQLite file is DATA_DIR/dhriti.db unless DATABASE_PATH is set. Empty DATA_DIR = in-memory, data lost on restart.
DATA_DIR=./data
DATABASE_PATH=
# 32-byte key (64 hex chars) encrypting contact numbers, live locations and share tokens at rest. If empty, one is created in DATA_DIR/data.key.
# On hosts with ephemeral disks, set it here, otherwise encrypted fields become unreadable after a redeploy.
DATA_KEY=
# Ed25519 private key (PEM, newlines as \n) signing evidence timestamps. If empty, one is created in DATA_DIR/evidence-key.pem.
EVIDENCE_SIGNING_KEY=

# Automatic alerts to trusted contacts (Twilio). Leave empty to turn alerts off: the app then says plainly that nobody is contacted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of: a sending number, or a Messaging Service SID (recommended for India: DLT-registered sender and template are required for SMS)
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Optional WhatsApp sender, e.g. +14155238886 (sandbox) or your approved number
TWILIO_WHATSAPP_FROM=

# Accounts. Users and sessions are saved in DATA_DIR; leave DATA_DIR empty and accounts vanish on restart.
# Password-reset email: set SMTP_URL (for example smtps://user:pass@smtp.example.com) and MAIL_FROM to send real mail.
# Without SMTP_URL the 6-digit code is printed in this server's console, labelled DEV ONLY, and nothing is emailed.
SMTP_URL=
MAIL_FROM=Dhriti <no-reply@your-domain.example>
# Set to 1 when the site is served over HTTPS so the session cookie is Secure (always Secure when NODE_ENV=production).
COOKIE_SECURE=
